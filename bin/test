#!/bin/sh
# Runs the tests inside the engine without opening a window.
cd "$(dirname "$0")/.." || exit 1
log=$(SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy ./dragonruby mygame --test tests/all.rb 2>&1)
echo "$log" | grep -E '\[Game\]' | grep -v -E 'Running:|Passed\.$' | sed 's/^- \[Game\] //'
echo "$log" | grep -q ' 0 test(s) failed' || exit 1
echo "$log" | grep -q -E '[1-9][0-9]* test\(s\) passed' || exit 1
